# PersonaGenAi Environment Configuration
# Copy this file to .env.local and fill in your API keys

# Google Gemini API Key (Required for AI profile generation)
API_KEY=your_gemini_api_key_here

# Backend API Configuration
BACKEND_API_ENDPOINT=http://localhost:3001/api

# Social Media API Credentials
# Instagram
INSTAGRAM_CLIENT_ID=your_instagram_client_id
INSTAGRAM_CLIENT_SECRET=your_instagram_client_secret
INSTAGRAM_REDIRECT_URI=http://localhost:5173/auth/instagram/callback

# Twitter/X
TWITTER_API_KEY=your_twitter_api_key
TWITTER_API_SECRET=your_twitter_api_secret
TWITTER_BEARER_TOKEN=your_twitter_bearer_token

# TikTok
TIKTOK_CLIENT_KEY=your_tiktok_client_key
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret

# Google Services Integration
GOOGLE_CALENDAR_ENABLED=false
GOOGLE_CALENDAR_ID=your_calendar_id

GOOGLE_DRIVE_ENABLED=false
GOOGLE_DRIVE_FOLDER_ID=your_folder_id

GOOGLE_ANALYTICS_ENABLED=false
GOOGLE_ANALYTICS_TRACKING_ID=your_tracking_id
